          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/ArtifactRelationship"
          },
          "title": "Relationships",
          "type": "array"
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/LifecycleStatus"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "title": {
          "maxLength": 200,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "id",
        "title",
        "status",
        "statement",
        "quality_attribute",
        "measurement",
        "acceptance_criteria"
      ],
      "title": "NonFunctionalRequirement",
      "type": "object"
    },
