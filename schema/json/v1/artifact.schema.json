{
  "$defs": {
    "ArchitectureDecision": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "artifact_type": {
          "const": "architecture_decision",
          "title": "Artifact Type",
          "type": "string"
        },
        "consequences": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Consequences",
          "type": "array"
        },
        "context": {
          "title": "Context",
          "type": "string"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "extensions": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "title": "Extensions",
          "type": "object"
        },
        "id": {
          "pattern": "^(REQ|NFR|ADR|DES|TST)-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$",
          "title": "Id",
          "type": "string"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/ArtifactRelationship"
          },
          "title": "Relationships",
          "type": "array"
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/LifecycleStatus"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "title": {
          "maxLength": 200,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "id",
        "title",
        "status",
        "context",
        "decision",
        "consequences"
      ],
      "title": "ArchitectureDecision",
      "type": "object"
    },
    "ArtifactKey": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^(REQ|NFR|ADR|DES|TST)-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^urn:raptor:repo:[a-z0-9][a-z0-9._-]{2,127}$",
          "title": "Repository Id",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "artifact_id"
      ],
      "title": "ArtifactKey",
      "type": "object"
    },
    "ArtifactRelationship": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "relation": {
          "$ref": "#/$defs/RelationshipType"
        },
        "target": {
          "discriminator": {
            "mapping": {
              "artifact": "#/$defs/ArtifactTarget",
              "uri": "#/$defs/UriTarget"
            },
            "propertyName": "target_kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ArtifactTarget"
            },
            {
              "$ref": "#/$defs/UriTarget"
            }
          ],
          "title": "Target"
        }
      },
      "required": [
        "relation",
        "target"
      ],
      "title": "ArtifactRelationship",
      "type": "object"
    },
    "ArtifactTarget": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^(REQ|NFR|ADR|DES|TST)-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^urn:raptor:repo:[a-z0-9][a-z0-9._-]{2,127}$",
          "title": "Repository Id",
          "type": "string"
        },
        "target_kind": {
          "const": "artifact",
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "target_kind",
        "repository_id",
        "artifact_id"
      ],
      "title": "ArtifactTarget",
      "type": "object"
    },
    "DesignComponent": {
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "items": {
            "$ref": "#/$defs/ArtifactKey"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "name": {
          "maxLength": 200,
          "title": "Name",
          "type": "string"
        },
        "responsibility": {
          "title": "Responsibility",
          "type": "string"
        }
      },
      "required": [
        "name",
        "responsibility"
      ],
      "title": "DesignComponent",
      "type": "object"
    },
    "DesignDocument": {
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "const": "design_document",
          "title": "Artifact Type",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/DesignComponent"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "extensions": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "title": "Extensions",
          "type": "object"
        },
        "id": {
          "pattern": "^(REQ|NFR|ADR|DES|TST)-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$",
          "title": "Id",
          "type": "string"
        },
        "interfaces": {
          "items": {
            "$ref": "#/$defs/DesignInterface"
          },
          "title": "Interfaces",
          "type": "array"
        },
        "overview": {
          "title": "Overview",
          "type": "string"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/ArtifactRelationship"
          },
          "title": "Relationships",
          "type": "array"
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/LifecycleStatus"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "title": {
          "maxLength": 200,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "id",
        "title",
        "status",
        "overview",
        "components"
      ],
      "title": "DesignDocument",
      "type": "object"
    },
    "DesignInterface": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "title": "Name",
          "type": "string"
        },
        "participants": {
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "minItems": 2,
          "title": "Participants",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description",
        "participants"
      ],
      "title": "DesignInterface",
      "type": "object"
    },
    "JsonValue": {},
    "LifecycleStatus": {
      "enum": [
        "draft",
        "proposed",
        "accepted",
        "implemented",
        "verified",
        "deprecated",
        "rejected",
        "superseded"
      ],
      "title": "LifecycleStatus",
      "type": "string"
    },
    "Measurement": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "comparator": {
                "enum": [
                  "eq",
                  "ne"
                ]
              },
              "unit": {
                "type": "string"
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "type": [
                  "integer",
                  "number"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "comparator": {
                "enum": [
                  "eq",
                  "ne"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "type": [
                  "string",
                  "integer",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "comparator": {
                "enum": [
                  "lt",
                  "lte",
                  "gt",
                  "gte"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "type": [
                  "integer",
                  "number"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "comparator": {
                "const": "range"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "oneOf": [
                  {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "integer"
                      }
                    ],
                    "type": "array"
                  },
                  {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "not": {
                          "type": "integer"
                        },
                        "type": "number"
                      },
                      {
                        "not": {
                          "type": "integer"
                        },
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  }
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "comparator": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "range"
          ],
          "title": "Comparator",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              ],
              "type": "array"
            }
          ],
          "title": "Target"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "comparator",
        "target"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "NonFunctionalRequirement": {
