{
  "$defs": {
    "IdentityDocument": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "IdentityDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "documents": {
      "patternProperties": {
        "^DOC-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$": {
          "$ref": "#/$defs/IdentityDocument"
        }
      },
      "title": "Documents",
      "type": "object"
    },
    "identity_version": {
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$",
      "title": "Identity Version",
      "type": "string"
    },
    "repository_id": {
      "pattern": "^urn:raptor:repo:[a-z0-9][a-z0-9._-]{2,127}$",
      "title": "Repository Id",
      "type": "string"
    }
  },
  "required": [
    "identity_version",
    "repository_id",
    "documents"
  ],
  "title": "IdentityManifest",
  "type": "object"
}
