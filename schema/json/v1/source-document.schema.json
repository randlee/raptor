          "title": "Quality Attribute",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/ArtifactRelationship"
          },
          "title": "Relationships",
          "type": "array",
          "uniqueItems": true
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "statement": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/LifecycleStatus"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "id",
        "title",
        "status",
        "statement",
        "quality_attribute",
        "measurement",
        "acceptance_criteria"
      ],
      "title": "NonFunctionalRequirement",
      "type": "object"
    },
    "OriginProvenance": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "pattern": "^DOC-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$",
