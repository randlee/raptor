        },
        "interfaces": {
          "items": {
            "$ref": "#/$defs/DesignInterface"
          },
          "title": "Interfaces",
          "type": "array"
        },
        "overview": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Overview",
          "type": "string"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/ArtifactRelationship"
          },
          "title": "Relationships",
          "type": "array",
          "uniqueItems": true
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/LifecycleStatus"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "id",
        "title",
        "status",
        "overview",
        "components"
      ],
      "title": "DesignDocument",
      "type": "object"
    },
    "DesignInterface": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "participants": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 2,
          "title": "Participants",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description",
        "participants"
      ],
      "title": "DesignInterface",
      "type": "object"
    },
    "JsonValue": {},
    "LifecycleStatus": {
      "enum": [
        "draft",
        "proposed",
        "accepted",
        "implemented",
        "verified",
        "deprecated",
        "rejected",
        "superseded"
      ],
      "title": "LifecycleStatus",
      "type": "string"
    },
    "MaterializationProvenance": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "imported"
              }
            }
          },
          "then": {
            "properties": {
              "parent_content_sha256": {
                "type": "null"
              },
              "template_set": {
                "type": "null"
              },
              "template_version": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "rendered"
              }
            }
          },
          "then": {
            "properties": {
              "parent_content_sha256": {
                "type": "string"
              },
              "template_set": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "template_version": {
                "type": "string"
              }
            },
            "required": [
              "parent_content_sha256",
              "template_set",
              "template_version"
            ]
          }
        }
      ],
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "operation": {
          "enum": [
            "imported",
            "rendered"
          ],
          "title": "Operation",
          "type": "string"
        },
        "parent_content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Content Sha256"
        },
        "parser_profile": {
          "pattern": "^[a-z][a-z0-9_-]*(?![\\s\\S])",
          "title": "Parser Profile",
          "type": "string"
        },
        "parser_profile_version": {
          "pattern": "^(?:[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
          "title": "Parser Profile Version",
          "type": "string"
        },
        "repository_path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*\\/$)(?!.*\\\\).+$",
          "title": "Repository Path",
          "type": "string"
        },
        "template_set": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Set"
        },
        "template_version": {
          "anyOf": [
            {
              "pattern": "^(?:[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Version"
        }
      },
      "required": [
        "repository_path",
        "content_sha256",
        "operation",
        "parser_profile",
        "parser_profile_version"
      ],
      "title": "MaterializationProvenance",
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "comparator": {
                "enum": [
                  "eq",
                  "ne"
                ]
              },
              "unit": {
                "type": "string"
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "type": [
                  "integer",
                  "number"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "comparator": {
                "enum": [
                  "eq",
                  "ne"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "type": [
                  "string",
                  "integer",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "comparator": {
                "enum": [
                  "lt",
                  "lte",
                  "gt",
                  "gte"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "type": [
                  "integer",
                  "number"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "comparator": {
                "const": "range"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "oneOf": [
                  {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "integer"
                      }
                    ],
                    "type": "array"
                  },
                  {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "not": {
                          "type": "integer"
                        },
                        "type": "number"
                      },
                      {
                        "not": {
                          "type": "integer"
                        },
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  }
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "comparator": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "range"
          ],
          "title": "Comparator",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              ],
              "type": "array"
            }
          ],
          "title": "Target"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "comparator",
        "target"
      ],
      "title": "Measurement",
      "type": "object"
    },
