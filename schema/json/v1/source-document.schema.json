              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/ArtifactRelationship"
