          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$"
          },
          "title": "Extensions",
          "type": "object"
        },
        "id": {
          "pattern": "^REQ-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$",
          "title": "Id",
          "type": "string"
        },
        "priority": {
          "anyOf": [
