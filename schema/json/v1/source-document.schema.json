        "origin": {
          "$ref": "#/$defs/OriginProvenance"
        }
      },
      "required": [
        "origin",
        "materialization"
      ],
      "title": "SourceProvenance",
      "type": "object"
    },
    "TestCase": {
      "additionalProperties": false,
      "properties": {
        "expected_result": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Expected Result",
          "type": "string"
        },
        "id": {
          "pattern": "^TC-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$",
          "title": "Id",
          "type": "string"
        },
        "steps": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "verifies": {
          "items": {
            "$ref": "#/$defs/ArtifactKey"
          },
          "minItems": 1,
          "title": "Verifies",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "title",
        "steps",
        "expected_result",
        "verifies"
      ],
      "title": "TestCase",
      "type": "object"
    },
    "TestPlan": {
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "const": "test_plan",
          "title": "Artifact Type",
          "type": "string"
        },
        "entry_criteria": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Entry Criteria",
          "type": "array"
        },
        "exit_criteria": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Exit Criteria",
          "type": "array"
        },
        "extensions": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$"
          },
          "title": "Extensions",
          "type": "object"
        },
        "id": {
          "pattern": "^TST-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$",
          "title": "Id",
          "type": "string"
        },
        "objective": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Objective",
          "type": "string"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/ArtifactRelationship"
          },
          "title": "Relationships",
          "type": "array",
          "uniqueItems": true
        },
        "scope": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Scope",
          "type": "string"
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/LifecycleStatus"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "test_cases": {
          "items": {
            "$ref": "#/$defs/TestCase"
          },
          "minItems": 1,
          "title": "Test Cases",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "id",
        "title",
        "status",
        "objective",
        "scope",
        "test_cases"
      ],
      "title": "TestPlan",
      "type": "object"
    },
    "UriTarget": {
      "additionalProperties": false,
      "properties": {
        "target_kind": {
          "const": "uri",
          "title": "Target Kind",
          "type": "string"
        },
        "target_uri": {
          "pattern": "^(?:https?://[^\\x00-\\x20\\x7f/?#]+(?:[/?#][^\\x00-\\x20\\x7f]*)?|urn:[A-Za-z0-9](?:[A-Za-z0-9-]{0,30}[A-Za-z0-9])?:[A-Za-z0-9()+,.:=@;$_!*'%/?#-]+)$",
          "title": "Target Uri",
          "type": "string"
        }
      },
      "required": [
        "target_kind",
        "target_uri"
      ],
      "title": "UriTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "discriminator": {
          "mapping": {
            "architecture_decision": "#/$defs/ArchitectureDecision",
            "design_document": "#/$defs/DesignDocument",
            "non_functional_requirement": "#/$defs/NonFunctionalRequirement",
            "requirement": "#/$defs/Requirement",
            "test_plan": "#/$defs/TestPlan"
          },
          "propertyName": "artifact_type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/Requirement"
          },
          {
            "$ref": "#/$defs/NonFunctionalRequirement"
          },
          {
            "$ref": "#/$defs/ArchitectureDecision"
          },
          {
            "$ref": "#/$defs/DesignDocument"
          },
          {
            "$ref": "#/$defs/TestPlan"
          }
        ]
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/SourceProvenance"
    },
    "schema_version": {
      "pattern": "^1\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "provenance",
    "artifacts"
  ],
  "title": "SourceDocument",
  "type": "object"
}
