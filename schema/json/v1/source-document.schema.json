          "title": "Relationships",
          "type": "array",
          "uniqueItems": true
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "statement": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/LifecycleStatus"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "id",
        "title",
        "status",
        "statement",
        "acceptance_criteria"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "end_line"
            ]
          },
          "then": {
            "required": [
              "end_column"
            ]
          }
        },
        {
          "if": {
            "required": [
              "end_column"
            ]
          },
          "then": {
            "required": [
              "end_line"
            ]
          }
        }
      ],
      "properties": {
        "end_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Column"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "start_column": {
          "minimum": 1,
          "title": "Start Column",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "start_column"
      ],
      "title": "SourceLocation",
      "type": "object"
    },
    "SourceProvenance": {
