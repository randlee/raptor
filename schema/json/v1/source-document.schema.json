{
  "$defs": {
    "ArchitectureDecision": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "artifact_type": {
          "const": "architecture_decision",
          "title": "Artifact Type",
          "type": "string"
        },
        "consequences": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Consequences",
          "type": "array"
        },
        "context": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Context",
          "type": "string"
        },
        "decision": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Decision",
          "type": "string"
        },
        "extensions": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$"
          },
          "title": "Extensions",
          "type": "object"
        },
        "id": {
          "pattern": "^ADR-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$",
          "title": "Id",
          "type": "string"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/ArtifactRelationship"
          },
          "title": "Relationships",
          "type": "array",
          "uniqueItems": true
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/LifecycleStatus"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "id",
        "title",
        "status",
        "context",
        "decision",
        "consequences"
      ],
      "title": "ArchitectureDecision",
      "type": "object"
    },
    "ArtifactKey": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^(REQ|NFR|ADR|DES|TST)-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^urn:raptor:repo:[a-z0-9][a-z0-9._-]{2,127}$",
          "title": "Repository Id",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "artifact_id"
      ],
      "title": "ArtifactKey",
      "type": "object"
    },
    "ArtifactRelationship": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "relation": {
          "$ref": "#/$defs/RelationshipType"
        },
        "target": {
          "discriminator": {
            "mapping": {
              "artifact": "#/$defs/ArtifactTarget",
              "uri": "#/$defs/UriTarget"
            },
            "propertyName": "target_kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ArtifactTarget"
            },
            {
              "$ref": "#/$defs/UriTarget"
            }
          ],
          "title": "Target"
        }
      },
      "required": [
        "relation",
        "target"
      ],
      "title": "ArtifactRelationship",
      "type": "object"
    },
    "ArtifactTarget": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^(REQ|NFR|ADR|DES|TST)-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^urn:raptor:repo:[a-z0-9][a-z0-9._-]{2,127}$",
          "title": "Repository Id",
          "type": "string"
        },
        "target_kind": {
          "const": "artifact",
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "target_kind",
        "repository_id",
        "artifact_id"
      ],
      "title": "ArtifactTarget",
      "type": "object"
    },
    "DesignComponent": {
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "items": {
            "$ref": "#/$defs/ArtifactKey"
          },
          "title": "Dependencies",
          "type": "array",
          "uniqueItems": true
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "responsibility": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Responsibility",
          "type": "string"
        }
      },
      "required": [
        "name",
        "responsibility"
      ],
      "title": "DesignComponent",
      "type": "object"
    },
    "DesignDocument": {
