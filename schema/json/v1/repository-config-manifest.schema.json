{
  "$defs": {
    "RepositoryConfigFiles": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "minLength": 6,
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\x00-\\x1f\\x7f])(?!(?:\\.git|\\.raptor)(?:/|$))(?:[^/]+/)*[^/]+\\.json(?![\\s\\S])",
          "title": "Identity",
          "type": "string"
        },
        "routing": {
          "minLength": 6,
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\x00-\\x1f\\x7f])(?!(?:\\.git|\\.raptor)(?:/|$))(?:[^/]+/)*[^/]+\\.toml(?![\\s\\S])",
          "title": "Routing",
          "type": "string"
        },
        "scan": {
          "minLength": 6,
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\x00-\\x1f\\x7f])(?!(?:\\.git|\\.raptor)(?:/|$))(?:[^/]+/)*[^/]+\\.toml(?![\\s\\S])",
          "title": "Scan",
          "type": "string"
        }
      },
      "required": [
        "scan",
        "routing",
        "identity"
      ],
      "title": "RepositoryConfigFiles",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "files": {
      "$ref": "#/$defs/RepositoryConfigFiles"
    },
    "repository_id": {
      "pattern": "^urn:raptor:repo:[a-z0-9][a-z0-9._-]{2,127}(?![\\s\\S])",
      "title": "Repository Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^1\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "repository_id",
    "files"
  ],
  "title": "RepositoryConfigManifest",
  "type": "object"
}
