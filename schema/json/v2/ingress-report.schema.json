{
  "$defs": {
    "IngressDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "IngressDiagnostic",
      "type": "object"
    },
    "IngressReportEntry": {
      "additionalProperties": false,
      "properties": {
        "canonical_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Digest"
        },
        "diagnostic": {
          "anyOf": [
            {
              "$ref": "#/$defs/IngressDiagnostic"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "document_id": {
          "anyOf": [
            {
              "pattern": "^DOC-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "field_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Count"
        },
        "materialization_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Materialization Digest"
        },
        "origin_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Digest"
        },
        "outcome": {
          "enum": [
            "imported",
            "diagnosed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProfileSelection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "relationship_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relationship Count"
        },
        "repository_path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*\\/$)(?!.*\\\\).+$",
          "title": "Repository Path",
          "type": "string"
        },
        "route": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "sqlite_outcome": {
          "enum": [
            "persisted",
            "validated",
            "not_attempted"
          ],
          "title": "Sqlite Outcome",
          "type": "string"
        },
        "typed_relationship_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Typed Relationship Count"
        },
        "uri_relationship_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri Relationship Count"
        }
      },
      "required": [
        "repository_path",
        "outcome",
        "sqlite_outcome"
      ],
      "title": "IngressReportEntry",
      "type": "object"
    },
    "ProfileSelection": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "pattern": "^[a-z][a-z0-9_-]*(?![\\s\\S])",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "pattern": "^(?:[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
          "title": "Profile Version",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version"
      ],
      "title": "ProfileSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*\\/$)(?!.*\\\\).+$",
      "title": "Config Path",
      "type": "string"
    },
    "database_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*\\/$)(?!.*\\\\).+$",
      "title": "Database Path",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/IngressReportEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "report_version": {
      "pattern": "^(?:[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "title": "Report Version",
      "type": "string"
    },
    "repository_id": {
      "pattern": "^urn:raptor:repo:[a-z0-9][a-z0-9._-]{2,127}(?![\\s\\S])",
      "title": "Repository Id",
      "type": "string"
    }
  },
  "required": [
    "report_version",
    "repository_id",
    "config_path",
    "database_path",
    "entries"
  ],
  "title": "IngressReport",
  "type": "object"
}
