{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "description": "The v2 generic index record; family-specific payloads are intentionally absent.",
      "properties": {
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "id": {
          "pattern": "^(?:(?:REQ|NFR|ADR)-[A-Z0-9][A-Z0-9-]*-[0-9]{4,}|TEST-[A-Z0-9][A-Z0-9-]*-[0-9]{4,}|DOC-[A-Z0-9][A-Z0-9-]*-[0-9]{3,})$",
          "title": "Id",
          "type": "string"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/Relationship"
          },
          "title": "Relationships",
          "type": "array"
        },
        "source": {
          "additionalProperties": true,
          "title": "Source",
          "type": "object"
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/LifecycleStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "subsections": {
          "items": {
            "$ref": "#/$defs/Subsection"
          },
          "title": "Subsections",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "id",
        "title"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "requirement",
        "non_functional_requirement",
        "architecture_decision",
        "design_document",
        "test_plan"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "DocumentSegment": {
      "additionalProperties": false,
      "properties": {
        "artifact_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Index"
        },
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "artifact"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DocumentSegment",
      "type": "object"
    },
    "LifecycleStatus": {
      "enum": [
        "Draft",
        "Proposed",
        "Active",
        "Approved",
        "Deprecated",
        "Superseded"
      ],
      "title": "LifecycleStatus",
      "type": "string"
    },
    "MaterializationProvenance": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "imported"
              }
            }
          },
          "then": {
            "properties": {
              "parent_content_sha256": {
                "type": "null"
              },
              "template_set": {
                "type": "null"
              },
              "template_version": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "rendered"
              }
            }
          },
          "then": {
            "properties": {
              "parent_content_sha256": {
                "type": "string"
              },
              "template_set": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "template_version": {
                "type": "string"
              }
            },
            "required": [
              "parent_content_sha256",
              "template_set",
              "template_version"
            ]
          }
        }
      ],
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "operation": {
          "enum": [
            "imported",
            "rendered"
          ],
          "title": "Operation",
          "type": "string"
        },
        "parent_content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Content Sha256"
        },
        "parser_profile": {
          "pattern": "^[a-z][a-z0-9_-]*(?![\\s\\S])",
          "title": "Parser Profile",
          "type": "string"
        },
        "parser_profile_version": {
          "pattern": "^(?:[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
          "title": "Parser Profile Version",
          "type": "string"
        },
        "repository_path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*\\/$)(?!.*\\\\).+$",
          "title": "Repository Path",
          "type": "string"
        },
        "template_set": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Set"
        },
        "template_version": {
          "anyOf": [
            {
              "pattern": "^(?:[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Version"
        }
      },
      "required": [
        "repository_path",
        "content_sha256",
        "operation",
        "parser_profile",
        "parser_profile_version"
      ],
      "title": "MaterializationProvenance",
      "type": "object"
    },
    "OriginProvenance": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "pattern": "^DOC-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$",
          "title": "Document Id",
          "type": "string"
        },
        "initial_repository_path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*\\/$)(?!.*\\\\).+$",
          "title": "Initial Repository Path",
          "type": "string"
        },
        "original_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Original Content Sha256",
          "type": "string"
        },
        "parser_profile": {
          "pattern": "^[a-z][a-z0-9_-]*(?![\\s\\S])",
          "title": "Parser Profile",
          "type": "string"
        },
        "parser_profile_version": {
          "pattern": "^(?:[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
          "title": "Parser Profile Version",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^urn:raptor:repo:[a-z0-9][a-z0-9._-]{2,127}(?![\\s\\S])",
          "title": "Repository Id",
          "type": "string"
        },
        "source_format": {
          "const": "markdown",
          "title": "Source Format",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "document_id",
        "initial_repository_path",
        "original_content_sha256",
        "source_format",
        "parser_profile",
        "parser_profile_version"
      ],
      "title": "OriginProvenance",
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "title": "Context",
          "type": "string"
        },
        "relation_type": {
          "title": "Relation Type",
          "type": "string"
        },
        "target_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Artifact Id"
        },
        "target_document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Document Id"
        },
        "target_repository_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Repository Id"
        },
        "target_token": {
          "title": "Target Token",
          "type": "string"
        }
      },
      "required": [
        "relation_type",
        "target_token",
        "context"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "end_line"
            ]
          },
          "then": {
            "required": [
              "end_column"
            ]
          }
        },
        {
          "if": {
            "required": [
              "end_column"
            ]
          },
          "then": {
            "required": [
              "end_line"
            ]
          }
        }
      ],
      "properties": {
        "end_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Column"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "start_column": {
          "minimum": 1,
          "title": "Start Column",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "start_column"
      ],
      "title": "SourceLocation",
      "type": "object"
    },
    "SourceProvenance": {
      "additionalProperties": false,
      "properties": {
        "materialization": {
          "$ref": "#/$defs/MaterializationProvenance"
        },
        "origin": {
          "$ref": "#/$defs/OriginProvenance"
        }
      },
      "required": [
        "origin",
        "materialization"
      ],
      "title": "SourceProvenance",
      "type": "object"
    },
    "Subsection": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "maximum": 6,
          "minimum": 3,
          "title": "Level",
          "type": "integer"
        },
        "markdown": {
          "title": "Markdown",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "source": {
          "additionalProperties": true,
          "title": "Source",
          "type": "object"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "level",
        "markdown",
        "ordinal"
      ],
      "title": "Subsection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "document_metadata": {
      "additionalProperties": true,
      "title": "Document Metadata",
      "type": "object"
    },
    "non_item_segments": {
      "items": {
        "$ref": "#/$defs/DocumentSegment"
      },
      "title": "Non Item Segments",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/SourceProvenance"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    }
  },
  "required": [
    "provenance",
    "artifacts"
  ],
  "title": "SourceDocument",
  "type": "object"
}
