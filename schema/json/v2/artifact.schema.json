{
  "$defs": {
    "ArtifactType": {
      "enum": [
        "requirement",
        "non_functional_requirement",
        "architecture_decision",
        "design_document",
        "test_plan"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "LifecycleStatus": {
      "enum": [
        "Draft",
        "Proposed",
        "Active",
        "Approved",
        "Deprecated",
        "Superseded"
      ],
      "title": "LifecycleStatus",
      "type": "string"
    },
    "Relationship": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "title": "Context",
          "type": "string"
        },
        "relation_type": {
          "title": "Relation Type",
          "type": "string"
        },
        "target_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Artifact Id"
        },
        "target_document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Document Id"
        },
        "target_repository_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Repository Id"
        },
        "target_token": {
          "title": "Target Token",
          "type": "string"
        }
      },
      "required": [
        "relation_type",
        "target_token",
        "context"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "end_line"
            ]
          },
          "then": {
            "required": [
              "end_column"
            ]
          }
        },
        {
          "if": {
            "required": [
              "end_column"
            ]
          },
          "then": {
            "required": [
              "end_line"
            ]
          }
        }
      ],
      "properties": {
        "end_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Column"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "start_column": {
          "minimum": 1,
          "title": "Start Column",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "start_column"
      ],
      "title": "SourceLocation",
      "type": "object"
    },
    "Subsection": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "maximum": 6,
          "minimum": 3,
          "title": "Level",
          "type": "integer"
        },
        "markdown": {
          "title": "Markdown",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "source": {
          "additionalProperties": true,
          "title": "Source",
          "type": "object"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "level",
        "markdown",
        "ordinal"
      ],
      "title": "Subsection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The v2 generic index record; family-specific payloads are intentionally absent.",
  "properties": {
    "artifact_type": {
      "$ref": "#/$defs/ArtifactType"
    },
    "content": {
      "default": "",
      "title": "Content",
      "type": "string"
    },
    "domain": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain"
    },
    "id": {
      "pattern": "^(?:(?:REQ|NFR|ADR)-[A-Z0-9][A-Z0-9-]*-[0-9]{4,}|TEST-[A-Z0-9][A-Z0-9-]*-[0-9]{4,}|DOC-[A-Z0-9][A-Z0-9-]*-[0-9]{3,})$",
      "title": "Id",
      "type": "string"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/Relationship"
      },
      "title": "Relationships",
      "type": "array"
    },
    "source": {
      "additionalProperties": true,
      "title": "Source",
      "type": "object"
    },
    "source_location": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceLocation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/LifecycleStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "subsections": {
      "items": {
        "$ref": "#/$defs/Subsection"
      },
      "title": "Subsections",
      "type": "array"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "artifact_type",
    "id",
    "title"
  ],
  "title": "Artifact",
  "type": "object"
}
