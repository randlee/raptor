---
name: nfr-new
version: 1.0.0
description: Author one new NFR record as a standalone Markdown file.
required_variables: [id, title, status, version, created, last_updated, owner]
defaults:
  supersedes: ""
  superseded_by: ""
  definitions: ""
  requirement_statement: ""
  must: []
  should: []
  must_not: []
  rationale: ""
  success_criteria: ""
  acceptance_criteria: []
  test_evidence: []
  dependencies: ""
  requires: []
  related: []
  product_applicability: ""
  applies_to: []
  does_not_apply_to: []
  implementation_notes: ""
  key_considerations: []
  test_strategy: ""
  test_types: []
  related_documents: ""
  requirements: []
  architecture_decisions: []
  design_documents: []
  work_items: []
  external_references: []
---
{#- Generated by scripts/authoring_templates.py. One obligation per MUST or MUST NOT item; the reason belongs in the rationale section; define project terms and acronyms in `definitions`; each acceptance criterion names a check that decides it. -#}
{%- macro items(label, values) -%}
{% if values %}
**{{ label }}:**

{% for value in values %}
- {{ value | replace("\n", "\n  ") }}
{% endfor %}

{% endif %}
{%- endmacro -%}
{%- macro checklist(label, values) -%}
{% if values %}
**{{ label }}:**

{% for value in values %}
- [ ] {{ value | replace("\n", "\n  ") }}
{% endfor %}

{% endif %}
{%- endmacro -%}
{%- macro text(label, value) -%}
{% if value %}
**{{ label }}:**

{{ value }}

{% endif %}
{%- endmacro -%}
{%- macro prose(value) -%}
{% if value %}
{{ value }}

{% endif %}
{%- endmacro -%}
{%- macro definitions_paragraph(value) -%}
{% if value %}
Definitions: {{ value }}

{% endif %}
{%- endmacro -%}
# Requirement: {{ title }}

**Status:** {{ status }}{{ '  ' }}
**Version:** {{ version }}{{ '  ' }}
**Created:** {{ created }}{{ '  ' }}
**Last Updated:** {{ last_updated }}{{ '  ' }}
**Owner:** {{ owner }}{{ '  ' }}
{% if supersedes %}
**Supersedes:** {{ supersedes }}{{ '  ' }}
{% endif %}
{% if superseded_by %}
**Superseded By:** {{ superseded_by }}{{ '  ' }}
{% endif %}

---

## {{ id }}: {{ title }}

**Status:** {{ status }}{{ '  ' }}

### Requirement Statement

{{ definitions_paragraph(definitions) }}{{ prose(requirement_statement) }}{{ items("MUST statements", must) }}{{ items("SHOULD statements", should) }}{{ items("MUST NOT statements", must_not) }}### Rationale

{{ prose(rationale) }}### Success Criteria

{{ prose(success_criteria) }}{{ checklist("Acceptance Criteria", acceptance_criteria) }}{{ items("Test Evidence", test_evidence) }}{% if dependencies or requires or related %}
### Dependencies

{{ prose(dependencies) }}{{ items("Requires", requires) }}{{ items("Related", related) }}{% endif %}
{% if product_applicability or applies_to or does_not_apply_to %}
### Product Applicability

{{ prose(product_applicability) }}{{ items("Applies To", applies_to) }}{{ items("Does Not Apply To", does_not_apply_to) }}{% endif %}
{% if implementation_notes or key_considerations %}
### Implementation Notes

{{ prose(implementation_notes) }}{{ items("Key Considerations", key_considerations) }}{% endif %}
{% if test_strategy or test_types %}
### Test Strategy

{{ prose(test_strategy) }}{{ items("Test Types", test_types) }}{% endif %}
{% if related_documents or requirements or architecture_decisions or design_documents or work_items or external_references %}
### Related Documents

{{ prose(related_documents) }}{{ items("Requirements", requirements) }}{{ items("Architecture Decisions", architecture_decisions) }}{{ items("Design Documents", design_documents) }}{{ items("Work Items", work_items) }}{{ items("External References", external_references) }}{% endif %}
