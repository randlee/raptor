---
name: requirement
version: 1.0.0
description: Render a schema record.
required_variables: [record, fields]
---
# Requirement: {{ record.title }}

{% for field in fields if field.level == "Header" %}{% if field.required or record[field.name] %}{% if field.shape == "Derived" %}**{{ field.label }}:** {{ record.id }} through {{ record.id }}{{ '  ' }}
{% else %}**{{ field.label }}:** {{ record[field.name] }}{{ '  ' }}
{% endif %}{% endif %}{% endfor %}
---

## {{ record.id }}: {{ record.title }}

{% for field in fields if field.level == "Item" and field.name not in ["id", "title"] %}**{{ field.label }}:** {{ record[field.name] }}{{ '  ' }}
{% endfor %}{% for field in fields if field.level == "Section" %}### {{ field.label }}

{% set value = record[field.name] %}{% if value is string %}{{ value }}

{% else %}{{ value.text }}

{% for label in fields if label.level == "Label" and label.section == field.label %}**{{ label.label }}:**
{% if label.shape == "StatementList" %}{% set modal = "Must" if label.label == "MUST Statements" else "Should" if label.label == "SHOULD Statements" else "MustNot" %}{% for item in value[label.name] if item.modal == modal %}- {{ item.text }}
{% endfor %}{% elif label.shape == "Checklist" %}{% for item in value[label.name] %}- {% if item.checked == true %}[x] {% elif item.checked == false %}[ ] {% endif %}{{ item.text }}
{% endfor %}{% elif label.shape == "IdList" %}{% for item in value[label.name] %}- {{ item.id }}{% if item.note %} — {{ item.note }}{% endif %}
{% endfor %}{% elif label.shape == "LinkList" %}{% for item in value[label.name] %}- [{{ item.text }}]({{ item.href }}){% if item.note %} — {{ item.note }}{% endif %}
{% endfor %}{% elif label.shape == "Text" %}{{ value[label.name] }}
{% else %}{% for item in value[label.name] %}- {{ item }}
{% endfor %}{% endif %}{{ '\n' }}{% endfor %}{% endif %}{{ '\n' }}{% endfor %}{{ '\n' }}
